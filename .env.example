# Copy to .env locally. Fill in your own provider settings; never commit secrets.
# Optional direct Gemini connection for the AI chat route (server only).
# Create a key in Google AI Studio and add it to the hosting provider's secret settings.
# Usage may be limited or billed under Google's current terms; no key is included here.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Backward-compatible Lovable gateway key. Used only when GEMINI_API_KEY is absent.
# This is a Lovable AI Gateway project key, NOT a direct Google Gemini API key.
LOVABLE_API_KEY=

# Cloud browser configuration: publishable values, not private secrets.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Cloud server configuration.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=

# Optional: privileged server operations only; not required by current chat/song routes.
# A managed Lovable Cloud service key is not available for export.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: used only when adding scheduled requests.
LOVABLE_CRON_SECRET=
LOVABLE_CRON_SECRET_PREVIOUS=
